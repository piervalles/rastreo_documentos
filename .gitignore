# ========================================================
# .gitignore - Sistema de Rastreo Documental (DocuTrace)
# ========================================================

# Variables de entorno y credenciales sensibles
.env
.env.backup
.env.local
.env.production
!.env.example

# Archivos de respaldo y volcados de base de datos
*.sql
*.sql.gz
*.sql.tar
*.bak
backups/
storage/backups/

# Logs y registros temporales del sistema
*.log
error_log
access_log
logs/
temp/
tmp/

# Datos persistentes de contenedores Docker locales
db_data/
mysql_data/

# Paquetes y dependencias externas (si se agregan en el futuro)
/vendor/
composer.phar
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Configuraciones de editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Archivos del Sistema Operativo
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Archivos temporales de pruebas y certificados
*.pem
*.key
*.cert
